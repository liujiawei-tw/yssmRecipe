MYSQL_DATABASE=yssm_recipe
MYSQL_USER=yssm
MYSQL_PASSWORD=change-this-password
MYSQL_ROOT_PASSWORD=change-this-root-password

FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=18080
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6379
ELASTICSEARCH_HOST_PORT=9200

# Replace your-dockerhub-namespace with DOCKERHUB_USERNAME or DOCKERHUB_NAMESPACE.
BACKEND_IMAGE=your-dockerhub-namespace/yssmrecipe-backend:latest
FRONTEND_IMAGE=your-dockerhub-namespace/yssmrecipe-frontend:latest
ES_JAVA_OPTS=-Xms512m -Xmx512m
